# ==========================================
# DJ Event Playlist App - Environment Config
# ==========================================

# ----------------------------
# Backend Server Configuration
# ----------------------------
BACKEND_PORT=4000
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
CORS_ORIGIN=http://localhost:5173

# BetterAuth Configuration
BETTERAUTH_SECRET=your_betterauth_secret_here_make_it_random
BETTERAUTH_URL=http://localhost:4000

# ----------------------------
# Database Configuration
# ----------------------------
# For docker-compose: postgresql://postgres:postgres@db:5432/djdb
# For local dev without docker: postgresql://postgres:postgres@localhost:5432/djdb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/djdb

# ----------------------------
# Frontend Configuration
# ----------------------------
VITE_FRONTEND_PORT=5173
VITE_BACKEND_URL=http://localhost:4000/api

# ----------------------------
# Third-Party Music APIs (Spotify, Apple, Tidal)
# ----------------------------

# Spotify Credentials (Required for global search proxy & playlist imports)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Tidal Credentials (Required for Tidal SDK/playlist integrations)
TIDAL_CLIENT_ID=your_tidal_client_id_here
TIDAL_CLIENT_SECRET=your_tidal_client_secret_here

# Apple Music (Required for MusicKit integrations)
APPLE_MUSIC_DEVELOPER_TOKEN=your_apple_music_developer_token_here
